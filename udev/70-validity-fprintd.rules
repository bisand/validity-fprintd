# Validity / Synaptics match-on-chip fingerprint sensors.
# Grants the seat's active local user access to the sensor.
SUBSYSTEM=="usb", ATTRS{idVendor}=="138a", ATTRS{idProduct}=="0090", TAG+="uaccess"
