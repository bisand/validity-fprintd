#!/sbin/openrc-run
# OpenRC service for validity-fprintd, for distributions without systemd.

name="validity-fprintd"
description="Validity fingerprint authentication daemon"

command="/usr/local/bin/validity-fprintd"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

# The sensor needs raw USB access and the DMI serial, both root-only.
command_user="root"

output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need dbus
    after udev
}

start_pre() {
    # Calibration data is cached here between runs.
    checkpath --directory --owner root:root --mode 0755 /var/lib/validity-fprintd

    if [ ! -x "$command" ]; then
        eerror "$command is missing"
        return 1
    fi
}

stop_post() {
    # The daemon reboots the sensor as it exits, which takes it off the USB bus
    # for a few seconds. Anything touching the sensor straight after should wait.
    ebegin "Sensor is rebooting; it will reappear shortly"
    eend 0
}
