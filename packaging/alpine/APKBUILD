# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=validity-fprintd
pkgver=0.1.2
pkgrel=0
pkgdesc="Rust fingerprint driver and fprintd-compatible daemon for Synaptics/Validity match-on-chip sensors"
url="https://github.com/bisand/validity-fprintd"
arch="x86_64 aarch64"
license="MIT"
# libusb is picked up automatically as so:libusb-1.0.so.0; zbus speaks D-Bus
# itself, so only the bus daemon is needed at run time, and polkit, which is
# asked before a fingerprint is added or removed. Not beside fprintd: both own
# net.reactivated.Fprint and ship its D-Bus policy and polkit actions.
depends="dbus polkit !fprintd"
makedepends="cargo libusb-dev"
# fprintd provides pam_fprintd and the fprintd-* clients, which this daemon
# serves but does not replace.
install="$pkgname.post-install $pkgname.post-deinstall"
subpackages="$pkgname-openrc"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
# No test suite yet.
options="!check"

_bins="validity-fprintd validity-probe validity-session validity-db
	validity-sensor validity-verify validity-baseline validity-firmware
	validity-provision"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	# Deliberately not --features vendored: link the system libusb so its
	# security updates apply here too.
	cargo build --release --frozen
}

package() {
	local b
	for b in $_bins; do
		install -Dm755 "target/release/$b" "$pkgdir/usr/bin/$b"
	done

	install -Dm644 udev/70-validity-fprintd.rules \
		"$pkgdir/usr/lib/udev/rules.d/70-validity-fprintd.rules"
	# Without fprintd, nothing else lets root own the bus name, or defines the
	# polkit actions the daemon asks about.
	install -Dm644 packaging/net.reactivated.Fprint.conf \
		"$pkgdir/usr/share/dbus-1/system.d/net.reactivated.Fprint.conf"
	install -Dm644 packaging/alpine/net.reactivated.fprint.device.policy \
		"$pkgdir/usr/share/polkit-1/actions/net.reactivated.fprint.device.policy"
	install -Dm755 scripts/fetch-firmware.sh \
		"$pkgdir/usr/share/$pkgname/fetch-firmware.sh"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

openrc() {
	default_openrc
	# The shipped script points at /usr/local/bin, where the install script
	# puts a source build; a package installs to /usr/bin.
	sed 's|/usr/local/bin/|/usr/bin/|' "$builddir"/packaging/openrc/validity-fprintd \
		> "$srcdir"/initd
	install -Dm755 "$srcdir"/initd "$subpkgdir/etc/init.d/$pkgname"
}

sha512sums="SKIP  validity-fprintd-0.1.2.tar.gz"
